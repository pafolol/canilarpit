{
  "name": "canilarpit",
  "private": true,
  "version": "0.1.0",
  "description": "Can I LARP It — FastAPI catalog and React reading interface, in one repo",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/api.ps1",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate.ps1",
    "db:seed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed.ps1"
  }
}
