APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/canilarpit
FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Clerk: configure both values before using authenticated endpoints.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000","http://localhost:5173"]

# Local-only authentication bypass. Never enable in production.
DEV_AUTH_BYPASS=false

# Optional S3-compatible storage for generated and uploaded media.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
MEDIA_PUBLIC_BASE_URL=
