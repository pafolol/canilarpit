APP_ENV=development
DEBUG=true

# PostgreSQL 15+. Create the database first, then run:
#   python -m alembic upgrade head
#   canilarpit seed
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/canilarpit

# In production every entry must be https and none may be "*": the API sends
# credentials, and a wildcard origin would share an admin session with anybody.
FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------------------------------------------------------------- guide generation
# Any OpenAI-compatible chat completions endpoint. Without a key the admin panel
# still works; it just cannot generate.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
AI_MAX_REPAIR_ATTEMPTS=2
AI_VERIFY_SOURCES=true
OPENAI_INPUT_USD_PER_MILLION=2.0
OPENAI_OUTPUT_USD_PER_MILLION=8.0

# ---------------------------------------------------------------- images
# The model picks a source per picture. Wikimedia Commons, TVmaze, AniList and
# Jikan need no key and are always available, so guides get illustrated even
# with everything below left blank.
#
#   pexels    generic photography: objects, food, drink, places, sport
#   fanart    transparent logos, banners and clear art for films and series
#
# TMDB is deliberately not here: it charges for commercial use. Film imagery
# comes from Commons instead. fanart resolves its ids through TVmaze and
# Wikidata, so it needs no second key.
#
# Free keys: https://www.pexels.com/api/ | https://fanart.tv/get-an-api-key/
PEXELS_API_KEY=
FANART_API_KEY=
IMAGE_RESULTS_PER_QUERY=8

# ---------------------------------------------------------------- authentication
# Email and password, kept here. There is no third-party identity provider and
# no registration endpoint: accounts are made by an administrator.
#
#   canilarpit create-user you@example.com --role admin
#
# Passwords are hashed with Argon2id and are not readable by anybody, including
# an administrator, who can only set a new one.

# How long a signed-in browser stays signed in. Two weeks. A session is a row,
# so it can be revoked at any moment regardless - that is the difference
# between this and a signed token, and why "sign out everywhere" works.
SESSION_LIFETIME_SECONDS=1209600

# Failed sign-ins per client per minute, and per account per minute. Both,
# because moving address beats the first and nothing beats the second. Cleared
# the moment a sign-in succeeds.
AUTH_FAILURES_PER_MINUTE=20
ACCOUNT_FAILURES_PER_MINUTE=10

# A ceiling on the whole admin surface per client per minute. Loose enough for
# `npm run db:upload` replaying the catalog, tight enough that a drained session
# is not free. The upload script waits out a 429 rather than half-finishing.
ADMIN_REQUESTS_PER_MINUTE=600

# Local-only sign-in that sends an identity header instead of a password. The
# settings validator refuses to let this be true in production, and the request
# path ignores the header there regardless.
DEV_AUTH_BYPASS=true

# ------------------------------------------------------------- hardening
# Swagger and the schema are a route-by-route map of the admin surface. They are
# always off when APP_ENV=production regardless of this; this turns them off
# somewhere else as well.
EXPOSE_API_DOCS=true

# Host header allowlist, e.g. ["canilarpit.com","www.canilarpit.com"]. Left
# empty the middleware is not installed at all, because an incomplete list here
# answers 400 to everything, health checks included.
TRUSTED_HOSTS=[]

# HSTS lifetime, sent only in production. One year.
HSTS_MAX_AGE_SECONDS=31536000

# The content policy is enforced by default and is the narrow one everywhere:
# nothing is loaded from a third-party origin. Flip this to true to watch it in
# the browser console without it blocking anything.
CSP_REPORT_ONLY=false
CSP_EXTRA_ORIGINS=[]

# ---------------------------------------------------------------- submissions
# Signs the submission form token and derives the anonymous client hash that
# rate limits and blocks are counted against. No raw address is ever stored.
# Rotating this invalidates open forms and every stored hash, which is how you
# clear a block list. Required in production; the app refuses to start without it.
SUBMISSION_SECRET=dev-only-change-me

# Set true ONLY when the app really is behind a proxy that sets X-Forwarded-For.
# Left false the header is ignored, because otherwise anybody mints a fresh
# identity per request by setting it themselves.
TRUST_FORWARDED_FOR=false

# The per-request limits are a flood guard and count every attempt, including
# rejected ones, so they are loose. What actually bounds the editorial queue is
# SUBMISSION_MAX_PENDING, which counts rows and frees up as editors work.
SUBMISSIONS_PER_HOUR=20/hour
SUBMISSIONS_PER_DAY=60/day
SUBMISSION_MAX_PENDING=3
SUBMISSION_MIN_SECONDS=4
SUBMISSION_TOKEN_TTL_SECONDS=3600
SUBMISSION_MIN_NOTES=80
SUBMISSION_MAX_LINKS=2

# ---------------------------------------------------------------- media storage
# Optional S3-compatible storage for uploaded and generated assets.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
MEDIA_PUBLIC_BASE_URL=

# ---------------------------------------------------------------- the public site
# Absolute, and the origin readers actually use. Open Graph tags and the sitemap
# are absolute URLs; a preview card cannot resolve a relative one.
SITE_BASE_URL=http://localhost:8000

# Where `npm run build` puts the app. When this directory has no index.html the
# API serves no HTML at all, which is the normal development case: Vite serves
# the frontend on 5173 and proxies here.
FRONTEND_DIST=frontend/dist

# One counted view per client per guide per window, so the number is a
# readership rather than a refresh count.
VIEW_DEDUPE_SECONDS=1800

# How long a heartbeat keeps somebody on the site, and the window the presence
# strip counts. Sweeping on the longer one leaves slack for one missed beat.
PRESENCE_WINDOW_SECONDS=120
PRESENCE_TTL_SECONDS=300
