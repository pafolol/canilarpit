APP_ENV=development
DEBUG=true

# PostgreSQL 15+. Create the database first, then run:
#   python -m alembic upgrade head
#   canilarpit seed
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/canilarpit

FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------------------------------------------------------------- guide generation
# Any OpenAI-compatible chat completions endpoint. Without a key the admin panel
# still works; it just cannot generate.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
AI_MAX_REPAIR_ATTEMPTS=2
AI_VERIFY_SOURCES=true
OPENAI_INPUT_USD_PER_MILLION=2.0
OPENAI_OUTPUT_USD_PER_MILLION=8.0

# ---------------------------------------------------------------- images
# Free key from https://www.pexels.com/api/. Without it, stock search returns 503
# and generated guides simply arrive without photographs.
PEXELS_API_KEY=
STOCK_RESULTS_PER_QUERY=8

# ---------------------------------------------------------------- authentication
# Clerk: configure both values before using authenticated endpoints in production.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=["http://localhost:5173","http://localhost:3000"]

# Local-only authentication bypass, used by the admin panel's "Local development"
# sign-in. The settings validator refuses to let this be true in production.
DEV_AUTH_BYPASS=true

# ---------------------------------------------------------------- media storage
# Optional S3-compatible storage for uploaded and generated assets.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
MEDIA_PUBLIC_BASE_URL=
