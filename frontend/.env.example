# Where the API lives when it is not proxied through the dev server.
# Leave empty in development: vite.config.ts proxies /api to VITE_API_PROXY.
VITE_API_BASE_URL=

# Dev-server proxy target.
VITE_API_PROXY=http://127.0.0.1:8000
VITE_PORT=5173

# Google Analytics measurement ID (G-XXXXXXXXXX). Left empty nothing is fetched
# and no cookie is set, which is what /privacy says when this is unset.
VITE_GA_ID=
